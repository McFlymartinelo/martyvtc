generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  TERMINEE
  ANNULEE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  motDePasseHash String?
  telephone      String?
  role           Role          @default(CLIENT)
  accounts       Account[]
  sessions       Session[]
  reservations   Reservation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Reservation {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  depart             String
  arrivee            String
  dateHeure          DateTime
  nombrePassagers    Int
  commentaire        String?
  typeCourse         String            @default("ville")
  zoneDepart         String?
  zoneArrivee        String?
  montantEstime      Int?
  numeroVol          String?
  terminal           String?
  heureAtterrissage  String?
  attenteApresVol    Boolean           @default(false)
  siegeEnfant        Boolean           @default(false)
  heuresDisposition  Int?
  pourAutrui         Boolean           @default(false)
  passagerNom        String?
  passagerTelephone  String?
  statut             StatutReservation @default(EN_ATTENTE)
  disponibiliteId    String?
  paiements          Paiement[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([dateHeure])
  @@index([statut])
}

model Disponibilite {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  heureDebut    String
  heureFin      String
  estDisponible Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@unique([date, heureDebut, heureFin])
}

model Paiement {
  id                    String         @id @default(cuid())
  reservationId         String
  reservation           Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?
  stripeCheckoutId      String?        @unique
  montant               Int
  statut                StatutPaiement @default(EN_ATTENTE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([reservationId])
}
