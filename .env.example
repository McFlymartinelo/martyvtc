# URL publique EXACTE (navigateur). En local : http://localhost:3000
# Sur le serveur, sans domaine : http://IP_PUBLIQUE
# Avec domaine + HTTPS : https://ton-domaine.fr
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=remplacez-par-une-chaine-longue-aleatoire
NEXTAUTH_SECRET=remplacez-par-une-chaine-longue-aleatoire

# Postgres (Docker production)
POSTGRES_USER=martyvtc
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=martyvtc
DATABASE_URL=postgresql://martyvtc:change-moi@db:5432/martyvtc?schema=public

# Caddy : ":80" = HTTP sur l'IP. Avec un domaine : vtc.example.com
SITE_ADDRESS=:80
ACME_EMAIL=admin@localhost

# Premier démarrage uniquement
SEED_ON_START=false
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme123

# Auth Google (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe — mode test par défaut
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# E-mails (Resend). Sans clé, les e-mails sont loggés en console.
RESEND_API_KEY=
EMAIL_FROM="Marty <noreply@example.com>"
